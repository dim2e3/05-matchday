{
	email {$ACME_EMAIL}
}

(common) {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

{$PROD_HOST} {
	import common
	reverse_proxy matchday-prod-frontend:8080
}

{$DEV_HOST} {
	import common
	reverse_proxy matchday-dev-frontend:8080
}

{$GRAFANA_HOST} {
	import common
	reverse_proxy grafana:3000
}
